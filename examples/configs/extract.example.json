{
  "job_id": "payment_extract",
  "table": "payment",
  "columns": [
    "payment_id",
    "customer_id",
    "staff_id",
    "rental_id",
    "amount",
    "payment_date"
  ],
  "filters": [
    {
      "column": "payment_date",
      "op": ">=",
      "value": "2007-04-06T00:00:00Z"
    },
    {
      "column": "payment_date",
      "op": "<",
      "value": "2007-04-13T00:00:00Z"
    },
    {
      "column": "customer_id",
      "op": ">=",
      "value": 300
    },
    {
      "column": "amount",
      "op": ">",
      "value": 5
    }
  ],
  "source": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password_env": "PGPASSWORD",
    "database": "test",
    "pool_max": 8,
    "statement_timeout_ms": 300000,
    "application_name": "el-ballista",
    "schema": "public"
  },
  "checkpoint": {
    "dir": "./.checkpoints"
  },
  "pushdown": {
    "policy": "cost_based",
    "deny": [],
    "push": []
  },
  "parallel_scan": {
    "strategy": "none",
    "partitions": 1,
    "partition_column": "payment_id"
  },
  "execution": {
    "batch_size": 8192
  },
  "distributed": {
    "scheduler_url": "",
    "workers": 2
  }
}
