{
  "job_id": "dvd_rental_incremental",
  "table": "payment",
  "columns": ["payment_id", "customer_id", "staff_id", "rental_id", "amount", "payment_date"],
  "filters": [
    { "column": "payment_date", "op": ">", "value": "2007-02-16" }
  ],
  "source": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password_env": "ORDERS_PG_PASSWORD",
    "database": "test",
    "pool_max": 8,
    "statement_timeout_ms": 300000,
    "application_name": "rust-extract-dvd-rental-incremental",
    "schema": "public"
  },
  "sink": {
    "path": "./warehouse/raw/payment_incremental"
  },
  "checkpoint": {
    "dir": "./.checkpoints"
  },
  "pushdown": {
    "policy": "cost_based",
    "deny": [],
    "push": []
  },
  "parallel_scan": {
    "strategy": "none",
    "partitions": 1,
    "partition_column": "payment_id"
  },
  "execution": {
    "batch_size": 8192
  },
  "distributed": {
    "scheduler_url": "",
    "workers": 2
  }
}
